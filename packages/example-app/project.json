{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-app",
  "root": "packages/example-app",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-bun:build",
      "options": {
        "entrypoints": ["src/main.ts"],
        "outputPath": "dist"
      },
      "outputs": ["{projectRoot}/dist/main.js"]
    },
    "serve": {
      "executor": "nx-bun:run",
      "continuous": true,
      "options": {
        "buildTarget": "example-app:build"
      }
    }
  }
}
