{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example-app",
  "root": "packages/example-app",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-bun:build",
      "continuous": true,
      "options": {
        "entry": "src/main.ts",
        "additionalEntryPoints": [
          {
            "name": "db/migrations/migration0",
            "path": "db/migrations/Migration20250331154716.ts"
          }
        ],
        "outputPath": "dist",
        "watch": true
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx-bun:run",
      "continuous": true,
      "dependsOn": [
        {
          "projects": "example-app",
          "target": "build"
        }
      ],
      "options": {
        "buildTarget": "example-app:build",
        "watch": true
      }
    },
    "serve-source": {
      "executor": "nx-bun:run",
      "continuous": true,
      "options": {
        "entry": "src/main.ts",
        "watch": true
      }
    }
  }
}
