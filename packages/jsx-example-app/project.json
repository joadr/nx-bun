{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "jsx-example-app",
  "root": "packages/jsx-example-app",
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-bun:build",
      "continuous": true,
      "dependsOn": [
        {
          "projects": "nx-bun",
          "target": "build"
        }
      ],
      "options": {
        "entry": "src/main.tsx",
        "outputPath": "dist",
        "watch": true
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx-bun:run",
      "continuous": true,
      "dependsOn": [
        {
          "projects": "jsx-example-app",
          "target": "build"
        }
      ],
      "options": {
        "buildTarget": "jsx-example-app:build",
        "watch": true
      }
    },
    "serve-source": {
      "executor": "nx-bun:run",
      "continuous": true,
      "dependsOn": [
        {
          "projects": "nx-bun",
          "target": "build"
        }
      ],
      "options": {
        "entry": "src/main.tsx",
        "watch": true
      }
    }
  }
}
