    "bun",
    "plugin",
    "executor"
  ],
  "peerDependencies": {
    "nx": "23.1.0"
  },
  "devDependencies": {
    "nx": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
