{
  "name": "nx-bun",
  "version": "0.0.1",
  "private": true,
  "description": "An Nx plugin for Bun",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "executors": "./executors.json",
  "generators": "./generators.json",
  "migrations": "./migrations.json",
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "migrations.json"
  ],
  "scripts": {
