{
  "$schema": "https://json-schema.org/schema",
  "title": "nx-bun build executor",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string",
      "description": "Primary Bun entry file to build"
    },
    "outputPath": {
      "type": "string",
      "description": "Output directory for Bun build artifacts"
    },
    "additionalEntryPoints": {
      "type": "array",
      "description": "Additional Bun entry points to build",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["name", "path"],
            "additionalProperties": false
          }
        ]
      }
    },
    "external": {
      "type": "array",
      "description": "Packages or paths to exclude from the bundle",
      "items": {
        "type": "string"
      }
    },
    "format": {
      "type": "string",
      "enum": ["esm", "cjs", "iife"],
      "description": "Module format for the bundle"
    },
    "minify": {
      "type": "boolean",
      "description": "Enable minification"
    },
    "sourcemap": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["inline", "external"] }
      ],
      "description": "Source map mode"
    },
    "splitting": {
      "type": "boolean",
      "description": "Enable code splitting"
    },
    "target": {
      "type": "string",
      "description": "Compilation target (defaults to bun)"
    },
    "define": {
      "type": "object",
      "description": "Compile-time definitions",
      "additionalProperties": {
        "type": "string"
      }
    },
    "naming": {
      "type": "string",
      "description": "Output naming pattern"
    },
    "publicPath": {
      "type": "string",
      "description": "Public path for runtime asset loading"
    },
    "bundle": {
      "type": "boolean",
      "description": "Enable Bun bundling instead of transpile-only output"
    },
    "compile": {
      "type": "boolean",
      "description": "Build standalone Bun executables"
    },
    "assets": {
      "type": "array",
      "description": "Files or directories to copy into the output path",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "input": {
                "type": "string"
              },
              "output": {
                "type": "string"
              }
            },
            "required": ["input"],
            "additionalProperties": false
          }
        ]
      }
    },
    "cliArgs": {
      "type": "array",
      "description": "Additional Bun CLI flags",
      "items": {
        "type": "string"
      }
    },
    "generatePackageJson": {
      "type": "boolean",
      "description": "Write a pruned package.json into the output directory"
    },
    "watch": {
      "type": "boolean",
      "description": "Keep rebuilding when files change"
    }
  },
  "required": ["entry", "outputPath"],
  "additionalProperties": false
}
